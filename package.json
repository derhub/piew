{
  "name": "@derhub/piew",
  "version": "0.6.1",
  "description": "Portable review — open Markdown, source files, and Git diffs in the browser, comment on exact lines, and send the batch back to your coding agent.",
  "keywords": [
    "agent",
    "cli",
    "code-review",
    "diff",
    "markdown",
    "review"
  ],
  "homepage": "https://github.com/derhub/piew#readme",
  "bugs": "https://github.com/derhub/piew/issues",
  "license": "MIT",
  "author": "derhub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derhub/piew.git"
  },
  "bin": {
    "piew": "./bin/piew.ts"
  },
  "files": [
    "bin",
    "src/cli",
    "src/lib",
    "src/server",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tool": "./src/lib/tool-api.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "perf": "bun scripts/perf.ts",
    "test": "bun test tests/unit tests/integration",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint && bun test tests/unit tests/integration && playwright test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "^1.62.1",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.30",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.32.0",
    "mermaid": "^11.16.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
